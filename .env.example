# Supabase URL and anon/public key are copied to assets/js/lib/config.js for this static site.
# The service-role key is ONLY for Supabase Edge Function secrets; never expose it to browsers.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Set these through `supabase secrets set` when deploying Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=EDGE_ONLY_SECRET
ALLOWED_ORIGINS=https://your-store.example
